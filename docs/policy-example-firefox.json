{
  "policies": {
    "ExtensionSettings": {
      "spruce@spruce-browser-extension": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/spruce@spruce-browser-extension/latest.xpi"
      }
    },
    "3rdparty": {
      "Extensions": {
        "spruce@spruce-browser-extension": {
          "managedEnableLinkUnmasking": true,
          "managedEnableTrackerReveal": true,
          "managedEnablePhishingFeeds": true,
          "managedEnableSenderChecks": true,
          "managedEnableSendCheck": true,
          "managedEnableSenderIdentity": true,
          "managedEnableSenderIconFallback": true,
          "managedEnableSenderAvatars": true,
          "managedEnableSenderBimi": true,
          "managedSenderPictureSize": "auto",
          "managedEnableCopyAddress": true,
          "managedEnableLookalikeCheck": true,
          "managedEnableOwnNameCheck": true,
          "managedEnableCallbackScamCheck": true,
          "managedEnableRowHighlighter": true,
          "managedRowHighlightColor": "yellow",
          "managedRowHighlightStyle": "both",
          "managedRowHighlightSelected": true,
          "managedRowHighlightSelectedColor": "blue",
          "managedEnableConflictWarnings": true,
          "managedEnableSenderCountry": true,
          "managedEnableSenderDomainCheck": true,
          "managedEnableSenderAddressCheck": true,
          "managedEnableAutoSpam": true,
          "managedEnableAutoSpamInSearch": true,
          "managedEnableSpamNotice": true,
          "managedEnableSpamFolderFlags": true,
          "managedEnableQrScanning": true,
          "managedEnableAttachmentScanning": true,
          "managedEnableOutlookSupport": true,
          "managedEnableProtonSupport": true,
          "managedEnableYahooSupport": true,
          "managedEnableAolSupport": true,
          "managedEnableZohoSupport": true,
          "managedEnableIcloudSupport": true,
          "managedEnableFastmailSupport": true,
          "managedEnableGmxSupport": true,
          "managedEnableOneTimeLinkProtection": true,
          "managedEnableMismatchWarnings": true,
          "managedEnableHiddenLinkProtection": true,
          "managedEnableClickConfirmation": true,
          "managedVisualOverrides": true,
          "managedEnableTrackingPixelBlocking": true,
          "managedRemoveTrackingPixels": true,
          "managedEnableThirdPartyResolution": true,
          "managedEnableDnsThreatCheck": true,
          "managedDnsQuad9": true,
          "managedDnsCloudflareSecurity": true,
          "managedDnsCloudflareFamily": true,
          "managedDnsControlD": true,
          "managedDnsDns4eu": false,
          "managedDnsAdGuard": true,
          "managedEnableRemoteListSync": true,
          "managedEnableResultCache": true,
          "managedEnableHistoryLog": true,
          "managedRetentionDays": 30,
          "managedDohEndpoint": "https://dns.example.com/dns-query?name={hostname}&type=A",
          "managedDohMethod": "GET",
          "managedUnshortenerEndpoint": "https://unshorten.example.com/?url={url}",
          "managedUnshortenerMethod": "GET",
          "managedUseUnshortenMeFallback": true,
          "managedAllowlist": [
            "internal.example.com"
          ],
          "managedBlocklist": [
            "click.marketing.example"
          ],
          "managedTrustedSenders": [
            "office@partner.example",
            "partner.example"
          ],
          "managedHidePopupSettingsButton": false,
          "managedHideRecentActivity": false,
          "managedHideDonateButton": false,
          "managedPhishSimulationRules": [],
          "managedPhishSimulationDomains": []
        }
      }
    }
  }
}
