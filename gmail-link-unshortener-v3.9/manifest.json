{
  "manifest_version": 3,
  "name": "Gmail Link Unshortener & Tracker Blocker",
  "version": "3.9",
  "description": "Scans Gmail for tracking links and blocks invisible email tracking pixels. Features managed policies and custom DNS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://unshorten.me/*",
    "https://security.cloudflare-dns.com/*",
    "https://family.cloudflare-dns.com/*",
    "https://dns.adguard-dns.com/*",
    "https://dns.quad9.net/*",
    "https://dns.google/*",
    "https://1.1.1.1/*",
    "https://raw.githubusercontent.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "schema.json"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}