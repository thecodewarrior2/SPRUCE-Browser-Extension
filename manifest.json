{
  "manifest_version": 3,
  "name": "Gmail Link Unshortener & Tracker Blocker",
  "version": "5.50",
  "description": "Shows where links in your email really go, flags phishing, look-alike sites, risky QR codes and attachments, and blocks tracking pixels in Gmail and other webmail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "link-unshortener@gmail-link-scanner",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "personalCommunications"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://unshorten.me/*",
    "https://security.cloudflare-dns.com/*",
    "https://family.cloudflare-dns.com/*",
    "https://dns.adguard-dns.com/*",
    "https://dns.quad9.net/*",
    "https://1.1.1.1/*",
    "https://raw.githubusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://firebasestorage.googleapis.com/*",
    "https://freedns.controld.com/*",
    "https://protective.joindns4.eu/*",
    "https://openphish.com/*",
    "https://phishing.army/*",
    "https://api.country.is/*",
    "https://www.google.com/s2/*",
    "https://icons.duckduckgo.com/*",
    "https://*.gstatic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    },
    "default_title": "Link Unshortener: not active here. Open an email to have it checked."
  },
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.proton.me/*",
        "https://mail.yahoo.com/*",
        "https://mail.aol.com/*",
        "https://mail.zoho.com/*",
        "https://mail.zoho.eu/*",
        "https://mail.zoho.in/*",
        "https://mail.zoho.com.au/*",
        "https://mail.zoho.jp/*",
        "https://mail.zoho.sa/*",
        "https://mail.zohocloud.ca/*",
        "https://www.icloud.com/*",
        "https://app.fastmail.com/*",
        "https://www.fastmail.com/*",
        "https://beta.fastmail.com/*",
        "https://*.gmx.com/*",
        "https://*.gmx.net/*",
        "https://*.gmx.de/*",
        "https://*.gmx.at/*",
        "https://*.gmx.ch/*",
        "https://*.gmx.co.uk/*",
        "https://*.gmx.fr/*",
        "https://*.gmx.es/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
